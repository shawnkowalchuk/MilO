<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The one colour in a values file, and it is not for a screen. Android paints the window
        with it before Compose has drawn anything (res/values/themes.xml), and Compose's tokens
        cannot be read that early. It repeats the page colour of the theme
        (core/designsystem/theme/Color.kt); a unit test (WindowBackgroundTest) fails if the two
        ever differ. The only other colours in XML are inside the launcher icon's and the
        notification icon's drawables (res/drawable/). Every colour of a screen is a token in
        that Kotlin file.
    -->
    <color name="milo_window_background">#121316</color>
</resources>
