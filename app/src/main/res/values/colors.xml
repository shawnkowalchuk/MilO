<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The colours in a values file, and none is for a screen. Every colour of a screen
        is a token in core/designsystem/theme/Color.kt; these are read by Android, outside
        Compose, where those tokens cannot be reached. Each repeats a colour of the theme, and a
        unit test fails if the two ever differ. The only other colours in XML are inside the
        launcher icon's and the notification icon's drawables (res/drawable/).
    -->
    <!--
        Android paints the window with it before Compose has drawn anything
        (res/values/themes.xml). The page colour of the theme; kept equal by
        WindowBackgroundTest.
    -->
    <color name="milo_window_background">#121316</color>
    <!--
        The colour of MilO's notifications (Notification.Builder.setColor): Android paints the
        small icon's surroundings with it in the notification shade, so the mark's lime shows
        where the icon itself cannot carry it (res/drawable/ic_stat_trip.xml). The accent of
        the theme; kept equal by NotificationAccentTest. Android may darken it on a light shade
        so that the icon stays readable.
    -->
    <color name="milo_notification_accent">#C6F432</color>
    <!--
        The Android Auto screen's colour (platform/car/TripStatusScreen.kt): the icons of its
        two rows and its button. The car draws the screen, outside Compose. The accent of the
        theme; kept equal by NotificationAccentTest. The car may replace it with a colour of its
        own where it judges the accent hard to read.
    -->
    <color name="milo_car_accent">#C6F432</color>
    <!--
        The home-screen widget's colours (res/layout/widget_home.xml): the home screen app draws
        it, outside Compose. Each is a colour of the theme, kept equal by WidgetColorsTest: the
        tile, the main and the secondary text, the accent, the text on the accent, and the fill
        of a quiet control.
    -->
    <color name="milo_widget_tile">#1E2025</color>
    <color name="milo_widget_text">#F2F3F5</color>
    <color name="milo_widget_text_secondary">#9298A3</color>
    <color name="milo_widget_accent">#C6F432</color>
    <color name="milo_widget_on_accent">#121316</color>
    <color name="milo_widget_control">#2C2F36</color>
</resources>
