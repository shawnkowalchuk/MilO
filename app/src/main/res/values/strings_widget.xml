<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The home-screen widget (Shawn's request of 2026-10-07): its name and line in the phone's
        list of widgets, its dollar line, and its tile in Settings. The status line and the
        button are the Android Auto screen's words (car_status_*, home_start_trip, home_end_trip).
    -->
    <string name="widget_label">MilO trip</string>
    <string name="widget_description">The trip in progress, Start and End, and business kilometres in dollars</string>
    <!--
        The arguments: the month, short (Oct), its business kilometres at the rate set in
        Settings in whole dollars ($412), the year (2026), the year's ($3,980), and the rate in
        dollars a kilometre ($0.70). The rate is passed as text, already written to the cent.
    -->
    <string name="widget_dollars">%1$s %2$s · %3$s %4$s at %5$s/km</string>
    <string name="widget_dollars_unknown">Business dollars: not available</string>
    <string name="widget_switched_off">MilO\'s widget is switched off. Turn it on in MilO, Settings.</string>

    <!-- Settings: the widget's tile. -->
    <string name="settings_widget_title">Home-screen widget</string>
    <string name="settings_widget_line">The trip, Start and End, and business kilometres in dollars</string>
    <!-- The rate the widget's dollars are priced at, and its value, such as $0.70/km. -->
    <string name="settings_widget_rate">Rate</string>
    <string name="settings_widget_rate_value">%1$s/km</string>
    <string name="settings_widget_rate_field">Dollars a kilometre</string>
    <!-- The grey example inside the empty field. -->
    <string name="settings_widget_rate_example">0.70</string>
    <!-- The arguments: the lowest and the highest rate that can be set, $0.01 and $5.00. -->
    <string name="settings_widget_rate_refused">Type the dollars a kilometre, such as 0.70: from %1$s to %2$s.</string>
    <string name="settings_widget_rate_save">Save rate</string>
    <string name="settings_widget_add">Add to home screen</string>
    <string name="settings_widget_how">To add it yourself: touch and hold an empty spot on the home screen, then Widgets, then MilO.</string>
    <string name="settings_about_widget">About the widget</string>
    <string name="settings_widget_detail">The dollars are this month\'s and this year\'s Business kilometres at the rate above, the same for every kilometre. They are for reference only: the report for the accountant stays in kilometres. Switched off, the widget cannot be added, and one already on the home screen says so, or is removed by the home screen.</string>
</resources>
