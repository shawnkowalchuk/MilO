<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The version on Settings and the What's new screen (Shawn's request of 2026-10-08: "a
        version number in the app under settings ... clickable ... with including version and
        what has changed"). The list itself is not here: it is app/src/main/assets/changelog.json,
        which the website's page is made from too.
    -->
    <string name="whats_new_title">What\'s new</string>
    <string name="whats_new_version_label">Version</string>
    <!-- The versionName and the versionCode: "0.1.0 · build 1". -->
    <string name="whats_new_version_value">%1$s · build %2$d</string>
    <string name="whats_new_version_hint">What changed in each version</string>
    <!-- What a screen reader says a press of the Version tile does, after "double tap to". -->
    <string name="whats_new_version_open">see what\'s new</string>
    <string name="whats_new_reading">Reading the list of changes…</string>
    <string name="whats_new_unreadable">The list of changes could not be read. The Log screen says why.</string>
    <!-- Above each version's changes: "0.1.0 · 9 Oct 2026", or with the line below. -->
    <string name="whats_new_release">%1$s · %2$s</string>
    <string name="whats_new_not_released">not released yet</string>
    <!-- After the version this phone has: "0.1.0 · not released yet · on this phone". -->
    <string name="whats_new_this_phone">%1$s · on this phone</string>
    <!-- The tags, in capitals like the event log's. -->
    <string name="whats_new_tag_new">NEW</string>
    <string name="whats_new_tag_improved">IMPROVED</string>
    <string name="whats_new_tag_fixed">FIXED</string>
    <string name="whats_new_tag_security">SECURITY</string>
</resources>
