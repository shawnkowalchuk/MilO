    <!-- Setup: the line under a row that is in order. -->
    <string name="setup_fine_allowed">Allowed.</string>
    <string name="setup_fine_background_location">Set to \"Allow all the time\".</string>
    <string name="setup_fine_location_services">Switched on.</string>
    <!-- The argument is the truck's name. -->
    <string name="setup_fine_truck">%1$s is paired, and Android is watching for it.</string>
    <string name="setup_fine_battery_exemption">MilO is exempt from battery optimisation.</string>
    <string name="setup_fine_unused_app_pause">\"Pause app activity if unused\" is off for MilO.</string>
    <string name="setup_fine_battery_saver_off">Battery Saver is off.</string>

    <!-- Setup: the line under a row that is not in order: why it matters and what to do. -->
    <string name="setup_fix_precise_location">MilO measures a trip from GPS positions. Allow precise location.</string>
    <string name="setup_fix_background_location">A trip that starts by itself starts while MilO is closed. Android opens its own location screen for this: choose \"Allow all the time\" there.</string>
    <string name="setup_fix_notifications">The trip notification, and the warning when a trip could not start, need this.</string>
    <string name="setup_fix_nearby_devices">Without it MilO cannot see the truck connect or disconnect.</string>
    <string name="setup_fix_location_services">Location is switched off for the whole phone. No trip can be recorded.</string>
    <string name="setup_fix_battery_exemption">Android may stop MilO to save battery. Allow it to run without battery optimisation.</string>
    <string name="setup_fix_unused_app_pause">Recommended. Switch off \"Pause app activity if unused\" for MilO, or Android stops it after months without being opened.</string>
    <string name="setup_fix_battery_saver_off">Battery Saver is on. It limits location and background work, so a trip can be missed or cut short.</string>
    <string name="setup_fix_xiaomi_battery_saver">MilO cannot read this setting. On MilO\'s app page, set Battery saver to \"No restrictions\", then confirm it here.</string>
    <string name="setup_fix_xiaomi_other_permissions">Recommended. MilO cannot read these. Under \"Other permissions\", switch on \"Show on Lock screen\", the permission to start or open windows in the background, and \"Permanent notification\". Then confirm it here.</string>
    <string name="setup_fix_xiaomi_recents_lock">MilO cannot read this. Open the recent apps, press and hold MilO\'s card and tap the padlock, so the cleaners leave MilO alone. Then confirm it here.</string>

