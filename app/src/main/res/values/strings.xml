    <!--
        The Android Auto screen. Its header is app_name, its button uses home_start_trip and
        home_end_trip, and "This trip" says trip_status_idle when there is none, so the car and
        the phone cannot word those differently.

        The three row titles must never change and never carry a figure: the car counts a redraw
        as a harmless refresh only while every row title stays the same. Each line under a title
        is kept short, because the car cuts long text off while driving.
    -->
    <string name="car_row_status">Status</string>
    <string name="car_row_this_trip">This trip</string>
    <string name="car_row_today">Today</string>
