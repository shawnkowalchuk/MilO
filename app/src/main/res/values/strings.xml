    <!-- The arguments are a day, the trip's times such as 08:14 – 08:39, and its distance. -->
    <string name="trip_edit_recorded_trip">%1$s\n%2$s · %3$s</string>
    <string name="trip_edit_recorded_note">You changed this trip by hand. Restoring puts these times and this distance back, removes any address you typed so that MilO looks it up again, and takes the \"edited by hand\" mark away.</string>
    <string name="trip_edit_restore">Restore recorded values</string>
    <string name="trip_edit_restore_title">Restore recorded values?</string>
    <!-- The argument is the recorded trip, as trip_edit_recorded_trip writes it. -->
    <string name="trip_edit_restore_text">%1$s\n\nThe times and the distance go back to these, and what you typed in their place is dropped. Any address you typed is removed and looked up again. The Log screen keeps a line that says what was changed.</string>
    <string name="trip_edit_restore_confirm">Restore</string>

    <!--
        The question asked before a screen is left while it holds something typed that has not
        been saved: by Back, by the screen's own arrow or by a button of the bottom bar.
    -->
    <string name="leave_unsaved_title">Leave without saving?</string>
    <string name="leave_unsaved_text">What you changed on this screen has not been saved. If you leave now, it is lost and nothing is stored.</string>
    <string name="leave_unsaved_discard">Discard</string>
    <string name="leave_unsaved_keep">Keep editing</string>

    <!-- Settings, opened from Home. -->
    <string name="settings_title">Settings</string>
    <string name="settings_reading">Reading the settings…</string>
    <string name="settings_unreadable">MilO cannot read its settings, so they cannot be shown or changed here. Trips are still recorded, with the usual values. The Log screen says why.</string>
    <string name="settings_could_not_save">That change could not be saved. The Log screen says why.</string>
    <string name="settings_truck_title">Truck</string>
    <string name="settings_truck_detail">A trip starts by itself when this truck connects.</string>
    <string name="settings_trips_title">Trips</string>
    <string name="settings_applies_next_trip">A change applies from the next trip. A trip that is being recorded may already use it.</string>
    <string name="settings_grace_label">Wait after the truck disconnects</string>
    <string name="settings_grace_detail">How long a trip stays open for the truck to reconnect. If it does, the same trip carries on.</string>
    <!-- The argument is a number of minutes from formatMinutes(), such as 2 or 2.5. -->
    <string name="settings_grace_value">%1$s min</string>
    <!-- Settings: spoken by the screen reader for the minus and the plus of each number. -->
    <string name="settings_grace_less">Wait less</string>
    <string name="settings_grace_more">Wait longer</string>
    <string name="settings_minimum_label">Shortest trip that counts</string>
    <string name="settings_minimum_detail">A shorter trip is discarded, such as moving the truck around the yard. A discarded trip can still be counted on the Trips screen.</string>
    <string name="settings_minimum_less">Count shorter trips</string>
    <string name="settings_minimum_more">Count only longer trips</string>
    <string name="settings_sound_title">Trip-start sound</string>
    <string name="settings_sound_enabled">Play a sound when a trip starts</string>
    <string name="settings_sound_built_in">Sound in use: the built-in sound</string>
    <string name="settings_sound_own">Sound in use: your own sound</string>
    <!-- The argument is the name of the audio file that was picked. -->
    <string name="settings_sound_own_named">Sound in use: your own sound, %1$s</string>
    <string name="settings_sound_note">It plays at the phone\'s notification volume, so it is silent when the phone is on silent, on vibrate, in Do Not Disturb or in Bedtime mode.</string>
    <string name="settings_sound_copying">Copying the sound…</string>
    <string name="settings_sound_play">Play</string>
    <string name="settings_sound_use_own">Use my own sound</string>
    <string name="settings_sound_use_built_in">Use the built-in sound</string>
    <!-- Settings: why a picked file did not become the sound. -->
    <string name="settings_sound_refused_copy">MilO could not copy that file. The sound was not changed.</string>
    <!-- The argument is the limit in megabytes. -->
    <string name="settings_sound_refused_large">That file is too large for a trip-start sound (more than %1$d MB). The sound was not changed.</string>
    <string name="settings_sound_refused_playable">That file cannot be played as a sound. The sound was not changed.</string>
    <string name="settings_sound_no_picker">This phone has no app to pick a file with. The sound was not changed.</string>

    <!-- Settings: the work schedule. -->
    <string name="settings_schedule_title">Work schedule</string>
    <string name="settings_schedule_intro">A trip that starts on a tracked day, between that day\'s start and end, is saved as Business. Any other trip is Personal. A trip that is still running at the end time is recorded to its end and marked \"ran past schedule\".</string>
    <string name="settings_schedule_applies">A change applies to trips that end after it. Trips already saved keep what they are; you can change any of them on the Trips screen.</string>
    <!-- The argument is a time of day from formatClockTime(), such as 08:00. -->
    <string name="settings_schedule_start">Start: %1$s</string>
    <string name="settings_schedule_end">End: %1$s</string>
    <!-- Settings: the titles of the time picker. The argument is a day, such as Monday. -->
    <string name="settings_schedule_pick_start">%1$s: start</string>
    <string name="settings_schedule_pick_end">%1$s: end</string>
    <string name="settings_schedule_copy">Use these hours on every tracked day</string>
    <string name="settings_schedule_hours_refused">A day\'s end must be later than its start. Nothing was changed. To move a whole day later, change its end first.</string>
    <!-- Settings: what becomes of a trip that starts outside the work schedule. -->
    <string name="settings_outside_title">Trips outside the work hours</string>
    <string name="settings_outside_personal">Save as Personal</string>
    <string name="settings_outside_personal_detail">They are listed on the Trips screen and added up apart from Business.</string>
    <string name="settings_outside_ignore">Ignore them</string>
    <!-- The argument is the label of the switch on the Trips screen that shows such trips. -->
    <string name="settings_outside_ignore_detail">They are still recorded, then left out of the list and the totals. Nothing is destroyed: on the Trips screen, switch on \"%1$s\" to see one and count it.</string>

    <!--
        The Android Auto screen. Its header is app_name, its button uses home_start_trip and
        home_end_trip, and "This trip" says trip_status_idle when there is none, so the car and
        the phone cannot word those differently.

        The three row titles must never change and never carry a figure: the car counts a redraw
        as a harmless refresh only while every row title stays the same. Each line under a title
        is kept short, because the car cuts long text off while driving.
    -->
    <string name="car_row_status">Status</string>
    <string name="car_row_this_trip">This trip</string>
    <string name="car_row_today">Today</string>
    <!-- The Status row. -->
    <string name="car_status_recording">Recording</string>
    <string name="car_status_recording_without_truck">Recording. Truck not connected</string>
    <string name="car_status_waiting_for_truck">Truck disconnected. Waiting for it to reconnect</string>
    <string name="car_status_not_recording">Not recording</string>
    <string name="car_status_truck_not_connected">Not recording. Truck not connected</string>
    <string name="car_status_setup_incomplete">Not recording. MilO\'s setup is incomplete</string>
    <string name="car_status_refused_location_permission">Could not start: location permission is missing</string>
    <string name="car_status_refused_background_location">Could not start: location is not set to \"Allow all the time\"</string>
