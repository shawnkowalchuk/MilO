    <!-- The same state on a Xiaomi phone. HyperOS has no "Unrestricted": its setting is Battery saver, with "No restrictions". -->
    <string name="setup_detail_battery_restricted_hyperos">Android reports that MilO is restricted in the background, which blocks trip recording. On MilO\'s app page, open Battery saver and choose \"No restrictions\".</string>
