    <string name="setup_section_android">Permissions and phone settings</string>
    <string name="setup_section_xiaomi">This Xiaomi phone (HyperOS)</string>
    <string name="setup_section_xiaomi_note">HyperOS has settings of its own that stop a closed app from being started. MilO can read only the first of them, and not with certainty. Set each one, then confirm it here.</string>

