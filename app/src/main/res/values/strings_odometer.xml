<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The truck's odometer (Shawn's decisions of 2026-10-07): its tile in Settings, under the
        truck's, and its figures on the report for the accountant. In a file of their own, like
        the words of Settings' layout.
    -->

    <string name="settings_odometer_title">Odometer</string>
    <!-- Where several vehicles are paired: "Odometer · Van". -->
    <string name="settings_odometer_title_of">Odometer · %1$s</string>
    <!-- Before the first reading has been typed in. -->
    <string name="settings_odometer_none">Type the number on the truck\'s dashboard once. MilO adds every truck trip to it from then on.</string>
    <!--
        The same with miles chosen. It names the unit, because the number is taken as miles
        whatever the dashboard shows; in kilometres the words stay as they were.
    -->
    <string name="settings_odometer_none_miles">Type the miles on the truck\'s dashboard once. MilO adds every truck trip to it from then on.</string>
    <!--
        Under the figure when it is the reading itself. The argument is the reading in the
        unit it was typed in, such as 123,456 km.
    -->
    <string name="settings_odometer_typed_today">Your reading of %1$s, typed today</string>
    <!-- Under the figure: the reading, the day it was typed, such as Oct 3, 2026. -->
    <string name="settings_odometer_no_trips_since">Your reading of %1$s on %2$s. No truck trip since.</string>
    <!-- The same, and the truck trips since in the unit on screen, such as 345.6 km. -->
    <string name="settings_odometer_trips_since">Your reading of %1$s on %2$s, plus %3$s of truck trips since</string>
    <string name="settings_odometer_enter">Enter reading</string>
    <string name="settings_odometer_adjust">Adjust</string>
    <string name="settings_odometer_field">Reading on the dashboard now</string>
    <!-- The field's label with miles chosen: what is typed is stored as miles. -->
    <string name="settings_odometer_field_miles">Reading on the dashboard now, in miles</string>
    <!-- The grey example inside the empty field. -->
    <string name="settings_odometer_example">123456</string>
    <!-- The argument is the unit's whole word, kilometres or miles. -->
    <string name="settings_odometer_refused">Type the %1$s the dashboard shows, such as 123456.</string>
    <string name="settings_odometer_save">Save reading</string>
    <string name="settings_about_odometer">About the odometer</string>
    <!-- The argument is the unit's whole word, kilometres or miles. -->
    <string name="settings_odometer_detail">MilO adds the %1$s of every trip in the truck to your last reading: Business, Personal, and trips you added by hand. A trip started with the button that the truck never joined is left out. Adjust it whenever the dashboard shows something else; each reading is kept with its date. The report for the accountant shows the odometer at the start and the end of its period, marked est. where MilO worked it out.</string>

    <!--
        The report for the accountant: the odometer at the start and the end of the period, on a
        tile under the sender's. The label's argument is the day, such as Oct 1, 2026.
    -->
    <string name="report_pdf_odometer_on">Odometer, %1$s</string>
    <!--
        A figure MilO worked out rather than one typed in that day. The argument is the
        odometer in whole kilometres or miles, such as 123,456; a figure that was typed is
        written with distance_km or distance_mi.
    -->
    <string name="report_pdf_odometer_estimated">%1$s km est.</string>
    <string name="report_pdf_odometer_estimated_mi">%1$s mi est.</string>
    <!-- With more than one vehicle's odometer: the vehicle's name, then "Odometer, 1 Oct 2026". -->
    <string name="report_pdf_odometer_of_vehicle">%1$s · %2$s</string>
    <string name="report_pdf_odometer_note">est.: worked out by MilO from a reading of the dashboard and the truck trips recorded since, not read off the dashboard on that day.</string>
    <!--
        Home's odometer tile (Shawn's request of 2026-10-09: "i want the milage on the home
        screen"; he chose the odometer reading). The figures are the ones Settings shows; a
        reading is typed there.
    -->
    <string name="home_odometer_title">Odometer</string>
    <string name="home_odometer_from_reading">Your last reading in Settings, plus every trip since</string>
    <string name="home_odometer_none">Type the number on the dashboard in Settings once. MilO adds every trip to it from then on.</string>
    <!-- A vehicle, among several, that has no reading yet. -->
    <string name="home_odometer_no_reading">No reading yet</string>
</resources>
