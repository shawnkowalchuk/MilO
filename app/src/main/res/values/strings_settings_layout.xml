<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The words that came with Settings being laid out as the owner's design draws it
        (2026-10-07). They are in a file of their own, beside strings.xml, because other
        screens were laid out at the same time and each kept out of the others' files. The
        words Settings had before are still in strings.xml, under "Settings".
    -->

    <!-- The truck's tile, while no truck is stored. The design's own words. -->
    <string name="settings_truck_none">None paired</string>
    <!-- The line under the truck's tile and the driving alert's that opens what both are for. -->
    <string name="settings_about_pair">About the truck and the driving alert</string>

    <!--
        Report for the accountant: the grey words inside each field while it is empty, as the
        design draws them, and the line that opens what the four fields are for.
    -->
    <string name="settings_report_name_example">[Your name]</string>
    <string name="settings_report_company_example">[Company]</string>
    <string name="settings_report_vehicle_example">Make, model and plate</string>
    <string name="settings_report_email_example">name@example.com</string>
    <string name="settings_about_report">About these details</string>

    <!--
        Monthly reminder: the line under its title. The argument is the stored day of the
        month, 1 to 31. English writes it with one of four endings, so there are four
        sentences; `ordinalEnding` in feature/settings/ReminderTile.kt picks one.
    -->
    <string name="settings_reminder_from_st">Daily from the %1$dst until the report is sent</string>
    <string name="settings_reminder_from_nd">Daily from the %1$dnd until the report is sent</string>
    <string name="settings_reminder_from_rd">Daily from the %1$drd until the report is sent</string>
    <string name="settings_reminder_from_th">Daily from the %1$dth until the report is sent</string>
    <string name="settings_about_reminder">About the reminder</string>

    <!-- Trips: the tile's label, as drawn, and the line that opens what its numbers do. -->
    <string name="settings_trips_label">Trips · applies from the next trip</string>
    <string name="settings_about_trips">About these three</string>
    <!--
        The tile under it (2026-10-07): the unit every distance is shown in. The two words are
        the two parts of the control; the sentence under it says what follows the choice.
    -->
    <string name="settings_units_title">Units</string>
    <string name="settings_units_kilometres">Kilometres</string>
    <string name="settings_units_miles">Miles</string>
    <string name="settings_units_detail">Every screen, the Android Auto screen, the widget, the notifications and the report for the accountant show distances in this unit. Stored trips are not changed, so you can switch back at any time.</string>

    <!-- Work schedule: the tile's label, as drawn. -->
    <string name="settings_schedule_label">Work schedule · trips in these hours are Business</string>
    <!-- What a screen reader says for a day's button, after the day's name. -->
    <string name="settings_schedule_day_on">Work day</string>
    <string name="settings_schedule_day_off">Not a work day</string>
    <!-- Stands between a start and an end: "8:00 AM – 4:30 PM". -->
    <string name="settings_schedule_dash">–</string>
    <!-- What a screen reader says a press on a start or an end does, after "double tap to". -->
    <string name="settings_schedule_set_time">set this time to the minute</string>
    <!--
        The line under the hours. The first argument is the number of work days, the second
        the hours they add up to, from formatHours(): "5 days · 42.5 h a week".
    -->
    <plurals name="settings_schedule_summary">
        <item quantity="one">%1$d day · %2$s h a week</item>
        <item quantity="other">%1$d days · %2$s h a week</item>
    </plurals>
    <!-- The same line while no day is a work day. The design's own words. -->
    <string name="settings_schedule_no_days">No days tracked: every trip is outside the work hours</string>
    <!-- What a screen reader calls the two handles of the slider for the whole week. -->
    <string name="settings_schedule_start_handle">Start of the work day</string>
    <string name="settings_schedule_end_handle">End of the work day</string>
    <!-- And of one day's own slider. The argument is the day's name: "Start on Friday". -->
    <string name="settings_schedule_start_handle_day">Start on %1$s</string>
    <string name="settings_schedule_end_handle_day">End on %1$s</string>
    <!-- Stands where a day's name stands in the time picker's title: "Every work day: start". -->
    <string name="settings_schedule_every_day">Every work day</string>
    <!-- The line that opens a slider for each work day, in place of the one for the week. -->
    <string name="settings_schedule_each_day">Set each day by itself</string>
    <!-- The same line while two work days differ: then it only names what stands under it. -->
    <string name="settings_schedule_each_day_caption">Each work day by itself</string>
    <string name="settings_about_schedule">About the work schedule</string>
    <string name="settings_schedule_slider_note">A slider moves in quarters of an hour. Press a start or an end to set it to the minute. While one slider stands for the week it sets the hours of all seven days, so a day you switch on later has them too.</string>

    <!-- The two sounds: the line under each title, which names the sound in use. -->
    <string name="settings_sound_line_built_in">Built-in chirp</string>
    <string name="settings_trip_sound_line_built_in">Built-in chime</string>
    <!-- For a sound of his own whose file had no name. Otherwise the file's name stands there. -->
    <string name="settings_sound_line_own">Your own sound</string>
    <!--
        Since 2026-10-07 the sound is played as an alarm, by the owner's decision, and so is the
        second one since 2026-10-08. "Like an alarm" is the whole truth in three words: whatever
        silences the phone's alarms (Do Not Disturb set to let nothing through, an alarm volume
        of zero) silences these too. Said once, under the second sound.
    -->
    <string name="settings_sound_alarm_note">Both sounds play like an alarm, at the alarm volume: also when the phone is on silent, on vibrate, in Do Not Disturb or in Bedtime mode.</string>

    <!-- Daily check: the name before its time, and the line that opens what the check does. -->
    <string name="settings_nothing_recorded_time_label">Check at</string>
    <string name="settings_about_check">About the daily check</string>

    <!--
        Backup, export and import: the line under the title and the two short words on the
        buttons, as drawn. A screen reader is told the longer names the buttons had before.
    -->
    <string name="settings_data_line">Keep a copy off the phone a few times a year</string>
    <string name="settings_data_export_short">Export</string>
    <string name="settings_data_import_short">Import</string>
    <string name="settings_about_data">About backup, export and import</string>

    <!--
        The tile that starts an email to MilO's support address in the phone's email app
        (2026-10-10). The address itself is in SupportTile.kt, as it is not to be translated.
    -->
    <string name="settings_support_label">Email support</string>
    <string name="settings_support_hint">Opens your email app with a new message. MilO\'s version and your phone\'s model are filled in at the end, to help with the answer. MilO is one person\'s project: answers come when he has time.</string>
    <!-- Spoken by the screen reader for what a press on the tile does. -->
    <string name="settings_support_open">write an email to support</string>
    <!-- The subject of the email, and the line at the end of its text. -->
    <string name="settings_support_subject">MilO Trip Log support</string>
    <string name="settings_support_about">MilO Trip Log %1$s (build %2$d) · Android %3$s · %4$s</string>
    <!-- On the tile after a press, on a phone with no email app. -->
    <string name="settings_support_no_email_app">No app on this phone writes emails. You can write to the address above from another device.</string>
    <!--
        The tile above Version (2026-10-08) that opens Shawn's page on Buy Me a Coffee in the
        browser. Its value is the page's address as it can be typed in.
    -->
    <string name="settings_coffee_label">Buy me a coffee</string>
    <string name="settings_coffee_value">buymeacoffee.com/SeaWingman</string>
    <string name="settings_coffee_hint">MilO is free, with no ads and no account. A coffee helps keep it that way. Opens in your browser.</string>
    <!-- Spoken by the screen reader for what a press on the tile does. -->
    <string name="settings_coffee_open">open the page in the browser</string>
    <!-- On the tile after a press, on a phone with no app that opens a web page. -->
    <string name="settings_coffee_no_browser">No app on this phone opens web pages. The address above can be typed into a browser on another device.</string>
</resources>
