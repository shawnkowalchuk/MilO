<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Each permission is added in the change that first needs it, so the manifest never asks
        for more than the code uses. These are the ones trip recording, trip detection, the
        setup checklist, the address lookup and the driving alert need (ADR-002).
    -->

    <!-- GPS fixes during a trip. Android requires the coarse permission beside the fine one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        "Allow all the time". Without it, a location service started while MilO is in the
        background throws on Android 14 and gets no location on Android 12 and 13. Every
        automatic trip start is such a start.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- The trip service. The second permission is required for its type from Android 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
        A runtime permission from Android 13. Without it the trip service still runs, but its
        notification and the "could not start this trip" warning are not shown.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        "Nearby devices", a runtime permission. Without it Android delivers no Bluetooth
        broadcast to MilO, and MilO cannot list the paired devices or ask whether the truck is
        connected. MilO never scans, so it does not ask for the scan permission.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        "Physical activity", a runtime permission. Without it the phone's driving detection
        reports nothing to MilO. Only the driving alert uses it, and the alert only notifies:
        a report of driving never starts a trip.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- The reconcile after a reboot: the truck may already be connected, and no event says so. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        The companion device association with the truck. All three are granted at install.
        - OBSERVE: Android binds MilO's companion service when the truck connects.
        - START_FOREGROUND_SERVICES_FROM_BACKGROUND: with an association, the documented and
          standing permission to start the trip service while MilO is in the background.
        - RUN_IN_BACKGROUND: declared on purpose. On Android 12 to 15, an app that has an
          association but not this permission is taken off the battery allowlist at every
          reinstall (ADR-002, "Permissions declared").
    -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />

    <!--
        Lets the address lookup ask whether the phone is online before it asks the geocoder,
        so that a trip which ended somewhere without signal does not use up its lookup attempts
        on failures. Granted at install, with no dialog. MilO still has no INTERNET permission
        and opens no connection itself: the lookup is done by the phone's own geocoder service.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Lets the setup checklist show Android's own dialog that exempts MilO from battery
        optimisation (ADR-002). Lint flags the permission because Google Play restricts it;
        MilO is installed from Android Studio on one phone and is never published there.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!--
        MilO is useless without GPS, but saying so here only matters to app stores, and MilO is
        installed from Android Studio on one phone. Declared as not required so the build never
        refuses an emulator image.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!--
        The same goes for Bluetooth and for companion device support. Whether HyperOS reports
        the companion feature is not known until tried, and MilO checks for it before every
        use: without it the Bluetooth receiver still works alone.
    -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!--
        CarConnection asks the Android Auto app whether it is connected, through that app's
        content provider. From Android 11 an app may only talk to another app it names here;
        without this entry the answer is always "not connected". The Car App Library's own
        manifest carries the same entry and the build merges the two. It is written out because
        holding a trip open over Android Auto depends on it.
    -->
    <queries>
        <provider android:authorities="androidx.car.app.connection" />
    </queries>

    <!--
        Backup is switched off on purpose until phase 4 designs it.
        Android restores backed-up data whenever the app is installed, including a reinstall from
        Android Studio. Until there are rules saying what is safe to restore, that would bring
        back stale trip state and a truck pairing that does not exist on the new install.
        allowBackup="false" stops cloud backup; it does NOT stop phone-to-phone transfer on
        Android 12 and later, which is why data_extraction_rules.xml excludes that as well.
    -->
    <application
        android:name=".app.MiloApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MilO">

        <!--
            windowSoftInputMode="adjustResize": when the keyboard comes up (the edit screen has
            the only text fields), Android must not slide the whole window up. MilO draws edge
            to edge, and a window that is slid up puts the form's text under the clock and
            takes the screen's title off the display. With this, the window stays where it is
            and MiloApp gives the keyboard's room up at the bottom instead.
        -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hands the report for the accountant to another app: the PDF to the email app or a
            viewer, the CSV to whatever Shawn shares it with. That app cannot read MilO's files
            by itself, so MilO gives it the address of one file through this provider, with a
            permission to read that file and nothing else.

            Not exported, and grantUriPermissions: nothing can ask the provider for a file on
            its own; only an app MilO has handed an address to can read it, for as long as its
            screen is open. The paths file names the one folder that can be handed out, the
            reports in the cache. The databases, the settings and the crash files are outside
            it and cannot be reached this way.

            This sends nothing anywhere. MilO still has no INTERNET permission.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_file_paths" />
        </provider>

        <!--
            Records a trip (ADR-002). Not exported: only MilO starts it.
            stopWithTask="false": swiping MilO out of the recent apps must not end a trip.
        -->
        <service
            android:name=".platform.trip.TripService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <!--
            Android binds this when the truck connects, starting MilO's process if it has to
            (ADR-002, the companion service). Exported because the binding comes from Android's
            companion device manager, outside MilO; the permission lets nothing else bind it.
            Android 12 refuses to bind unless an app declares exactly one such service.
        -->
        <service
            android:name=".platform.bluetooth.TruckCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!--
            The truck's link going up or down, and its hands-free and audio profiles changing
            state (ADR-002, the Bluetooth receiver). It must be exported: the sender is the
            Bluetooth app, not Android's core, and a receiver that is not exported never hears
            it. That is safe because all four actions are protected broadcasts, which no other
            app may send; the receiver drops anything else. The trip service registers the same
            class for itself during a trip.
        -->
        <receiver
            android:name=".platform.bluetooth.TruckBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            The Android Auto screen (platform/car/). Android Auto binds this service when MilO is
            opened on the car's display. The action is the Car App Library's. The category has to
            be one of the library's own, and none is for logging trips: IOT ("see the state of
            a device, switch something on or off with one touch") is the nearest to a status
            screen with a Start and End button.

            Exported with no permission, because the binding comes from the Android Auto app and
            Android has no permission for it on a phone. What protects it is the check in
            MiloCarAppService.createHostValidator, which lets only Android Auto itself in. Lint's
            ExportedService warning is switched off for that reason, as Google's guide says to.

            It has no android:process of its own on purpose: it must run in the same process as
            the trip service, which is where the GPS recording and the trip controller live.
        -->
        <service
            android:name=".platform.car.MiloCarAppService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!-- Where Android Auto reads what kind of car app MilO is: a template (Car App Library) app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
            The oldest Car API level MilO's screen works with. 7, because the screen's header is
            built with the library's current Header class, which needs it. The level is a property
            of the Android Auto app on the phone, not of the truck. Without this entry the library
            refuses the connection.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />

        <!--
            Where the phone's driving detection reports that Shawn has entered or left a vehicle
            (platform/driving/). Declared here so that a report can start MilO's process. It
            posts a notification at most; it never starts a trip. Not exported and without an
            intent filter: the report comes through a PendingIntent that MilO makes itself and
            aims at this class by name, which Android delivers as coming from MilO.
        -->
        <receiver
            android:name=".platform.driving.DrivingReceiver"
            android:exported="false" />

        <!--
            The reconcile after a reboot and after an update of MilO: the two moments at which
            the truck can already be connected with no event to say so. Not exported: both
            broadcasts come from Android's core.
        -->
        <receiver
            android:name=".platform.bluetooth.TruckReconcileReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
